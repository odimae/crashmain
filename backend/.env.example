# Supabase: Connect button > Transaction pooler (port 6543). Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.PROJECTREF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Your web dashboard address(es), comma separated, no trailing slash. The mobile app does not need CORS.
CORS_ORIGIN=http://localhost:5173
PORT=4000
# Only used by "npm run seed" (run on your computer, never on Vercel)
ADMIN_EMAIL=dispatcher@crashaid.co.ke
ADMIN_PASSWORD=
